---
// src/components/Navbar.astro
import { siteInfo, jurusan } from '../data/siteData.js';
---

<nav class="fixed top-0 left-0 w-full z-50 bg-white/60 backdrop-blur-2xl border-b border-white/50 px-6 md:px-14 py-4 flex justify-between items-center transition-all duration-300 shadow-sm">
    
    <!-- Logo Section: SMKN 3 LINGGABUANA PURWAKARTA -->
    <div class="flex items-center gap-3 group cursor-pointer">
        <img src={siteInfo.logo} class="w-8 h-auto drop-shadow-sm transition-transform duration-500 group-hover:scale-110" alt="Logo SMKN 3" />
        <div class="flex flex-col border-l border-slate-200/50 pl-3">
            <span class="font-black text-[10px] tracking-[0.2em] uppercase text-slate-800 leading-none">SMKN 3 LINGGABUANA</span>
            <span class="text-[8px] font-bold text-blue-600 uppercase tracking-[0.4em] mt-1.5">Purwakarta</span>
        </div>
    </div>
    
    <!-- Desktop Menu -->
    <div class="hidden md:flex gap-10 text-[10px] font-black uppercase tracking-widest text-slate-500 items-center">
        <a href="/" class="hover:text-slate-900 transition-colors text-slate-900 border-b border-slate-900 pb-1">Beranda</a>
        <a href="/profil" class="hover:text-slate-900 transition-colors pb-1">Profil</a>
        
        <!-- Dropdown -->
        <div class="relative group py-2">
            <button class="flex items-center gap-1 hover:text-slate-900 uppercase cursor-pointer outline-none font-black transition-all">
                Konsentrasi Keahlian
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                </svg>
            </button>
            
            <div class="absolute left-0 top-full w-72 hidden group-hover:block fade-in z-[60] pt-4">
                <div class="bg-white/95 backdrop-blur-3xl border border-white/80 shadow-[0_20px_50px_rgba(0,0,0,0.1)] py-4">
                    <div class="px-6 py-2 overflow-y-auto max-h-[450px] flex flex-col gap-4">
                        {jurusan.map(j => (
                            <a href={`/jurusan/${j.slug}`} class="text-[9px] font-bold text-slate-500 hover:text-blue-600 tracking-widest uppercase transition-all hover:translate-x-1 flex items-center justify-between group/link">
                                {j.name}
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-2.5 w-2.5 opacity-0 group-hover/link:opacity-100 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M9 5l7 7-7 7" />
                                </svg>
                            </a>
                        ))}
                    </div>
                </div>
            </div>
        </div>

        <!-- Tombol Arsip Digital (Link Baru & Tanpa Target Blank) -->
        <a href="https://kurikulum.smkn3linggabuana.sch.id/" class="px-5 py-2.5 bg-blue-600 text-white hover:bg-slate-900 transition-all duration-300 shadow-md hover:shadow-lg active:scale-95 font-black text-[9px] tracking-widest uppercase">
            Arsip Digital
        </a>
    </div>

    <!-- Mobile Toggle -->
    <div class="md:hidden">
        <button id="menu-toggle" class="text-slate-800 p-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16m-7 6h7" />
            </svg>
        </button>
    </div>
</nav>