---
// src/components/PostGrid.astro
const { categoryName, categorySlug, posts } = Astro.props;
---
<section class="fade-in group/section">
    <div class="flex flex-col items-center text-center mb-16 gap-4">
        <div class="w-12 h-[2px] bg-blue-500 transition-all duration-700 group-hover/section:w-24"></div>
        <div class="flex flex-col gap-2">
            <h2 class="text-2xl md:text-3xl font-light tracking-[0.3em] uppercase text-slate-800">{categoryName}</h2>
            <span class="text-[9px] font-mono text-slate-400 uppercase tracking-[0.6em]">SMKN3 Digital Resource — Archive</span>
        </div>
        <a href={`/category/${categorySlug}`} class="mt-4 group flex items-center gap-3 text-[9px] font-black uppercase tracking-[0.3em] text-slate-400 hover:text-blue-600 transition-all">
            <span>Lihat Semua</span>
        </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12">
        {posts.map((post) => (
            <article class="flex flex-col h-full group bg-white glass-card overflow-hidden border border-slate-200/60 rounded-2xl transition-all duration-700 hover:shadow-2xl hover:-translate-y-2">
                <a href={`/posts/${post.slug}`} class="cursor-pointer block h-full">
                    <div class="relative overflow-hidden aspect-video bg-slate-100 border-b border-slate-100">
                        {post.featuredImage ? (
                            <img src={post.featuredImage.node.sourceUrl} alt={post.title} class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110" />
                        ) : (
                            <div class="w-full h-full bg-slate-200 flex items-center justify-center text-[8px] font-mono uppercase text-slate-400">No Image</div>
                        )}
                    </div>
                    <div class="p-6 text-left items-start">
                        <span class="text-[9px] font-bold text-slate-400 uppercase tracking-widest mb-3 block">{categoryName}</span>
                        <h3 class="text-lg font-bold text-slate-800 leading-snug tracking-tight group-hover:text-blue-600 transition-colors uppercase line-clamp-2">{post.title}</h3>
                        <p class="mt-3 text-[10px] text-slate-500">{new Date(post.date).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
                        <div class="mt-6 w-6 h-[2px] bg-slate-200 group-hover:w-full group-hover:bg-blue-500 transition-all duration-700"></div>
                    </div>
                </a>
            </article>
        ))}
    </div>
</section>